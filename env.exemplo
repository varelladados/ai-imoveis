# Copie para .env.local (que não entra no git) ou configure no painel da Vercel.
# Nunca escreva uma chave de verdade neste arquivo.

# Quem interpreta a mensagem: regras (padrão, sem chave) | anthropic | gateway
AI_PROVIDER=regras

# Só com AI_PROVIDER=anthropic (Claude API direta)
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5

# Só com AI_PROVIDER=gateway (Vercel AI Gateway)
# AI_GATEWAY_API_KEY=
# AI_MODEL=   (o nome do modelo como aparece no painel do AI Gateway)

# Fonte privada: 1 liga a leitura de dados/privado/imoveis.json (fora do git).
# Só no computador do dono. No site público, deixe sem definir.
# AI_FONTE_PRIVADA=1
